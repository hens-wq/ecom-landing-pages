# Copy this file to .env.local and fill in real values when providers are chosen.
# Nothing here is read by client-side code - these are only ever used inside
# server-side code (API routes / lib/services/*), so it is safe to keep real
# secrets in these variables without risking exposure to the browser.

# --- Quiz review email (Task 4E) --------------------------------------------
# The mailbox that should receive a structured review email whenever a rep
# submits a knowledge exam (MCQ results + open-question answer + AI grading
# recommendation). Left unset until the review address is finalized -
# lib/services/email/stub-email-service.ts logs a warning and skips sending
# instead of guessing an address.
QUIZ_REVIEW_EMAIL=

# API key for whichever email provider is eventually wired into
# lib/services/email (e.g. Resend, SES, Postmark). Not used by the current
# stub implementation.
# EMAIL_PROVIDER_API_KEY=

# --- AI open-answer evaluator (Task 4F) -------------------------------------
# API key for whichever AI provider is eventually wired into
# lib/services/ai-evaluator (e.g. Anthropic). Not used by the current stub
# implementation - lib/services/ai-evaluator/stub-ai-evaluator-service.ts
# returns a clearly-marked placeholder recommendation instead of a real score.
# ANTHROPIC_API_KEY=
