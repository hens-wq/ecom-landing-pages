# Meta Marketing API - Phase 2A (read-only)
#
# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it's already gitignored). All of these are read server-side only (see
# src/lib/advertising/meta/config.ts) - none of them are exposed to the browser,
# and none use the NEXT_PUBLIC_ prefix on purpose.
#
# If META_ACCESS_TOKEN and META_AD_ACCOUNT_ID are both left empty, the dashboard
# automatically falls back to the existing mock advertising data (Phase 1
# behavior) - this is the expected state until you provide real credentials.

# A valid Meta access token with ads_read permission on the ad account below.
# For a long-lived, non-expiring integration, use a System User access token
# generated in Meta Business Settings (Business Settings -> Users -> System
# Users -> Generate New Token), not a short-lived personal user token.
META_ACCESS_TOKEN=

# The Meta Ads account to read from. Either form works - with or without the
# "act_" prefix (e.g. "act_1234567890" or just "1234567890"); it's normalized
# automatically. Find it in Meta Ads Manager: Account overview, or in the URL
# when viewing the account (act_<numbers>).
META_AD_ACCOUNT_ID=

# The Meta App this token belongs to. Not required for the read-only calls this
# phase makes, but kept for reference/traceability and for a future
# appsecret_proof / token-refresh flow.
META_APP_ID=

# Graph API version to call, e.g. "v26.0". Meta retires versions roughly every
# 2 years, so this WILL need bumping over time - keeping it here instead of
# hardcoded in source means updating it never requires a code change.
META_GRAPH_API_VERSION=v26.0

# IANA timezone "Today" / date-range presets are resolved in, so they match
# Ads Manager's own "Today" instead of drifting with the server's UTC clock.
# Defaults to "Asia/Jerusalem" if left empty - only set this if the ad
# account's actual configured reporting timezone is different.
REPORTING_TIMEZONE=

# Neon Postgres connection string for the internal lead status/payment data
# (see src/lib/lead-status/db.ts + repository.ts) - Main/Secondary status and
# payment amounts on the Leads page. Read server-side only, never exposed to
# the browser. When linked to a Vercel project through the Neon integration,
# Vercel sets this automatically for Production and Preview - you don't need
# to set it here unless you're also running this app outside Vercel (e.g.
# local development against your own Neon branch/database).
DATABASE_URL=

# Landing Page Leads - fan-out ingestion (see src/app/api/landing-leads/route.ts)
#
# Shared secret your external landing-page tool / Make.com scenario must send
# as `Authorization: Bearer <this value>` when POSTing a lead to
# /api/landing-leads. Generate any long random string (e.g. `openssl rand
# -hex 32`) - this is the only endpoint in this app that accepts writes from
# outside Vercel's own origin, so without this set, the endpoint refuses
# every request rather than accepting unauthenticated ones.
LANDING_LEADS_API_SECRET=

# Lead Status Webhook - external status updates (see
# src/app/api/webhooks/lead-status/route.ts)
#
# Shared secret an external automation (e.g. a Make.com scenario) must send
# as `Authorization: Bearer <this value>` when POSTing a Main/Secondary
# status update for a lead, keyed by its Meta Lead ID. Deliberately a
# SEPARATE secret from LANDING_LEADS_API_SECRET - a leak of one integration's
# credential should never grant write access to the other. Generate any long
# random string (e.g. `openssl rand -hex 32`); leaving this empty makes the
# endpoint refuse every request.
LEAD_STATUS_WEBHOOK_SECRET=

# Rating-only webhook secret (see src/app/api/webhooks/lead-status/route.ts). A request with this key may
# send only a student-rating update (studentRating, or the Fireberry field pcfsystemfield350). Any status or
# payment field is refused with 403. Empty = rating-only updates are refused.
LEAD_RATING_WEBHOOK_SECRET=

# Temporary housekeeping for orphan status rows (see
# src/app/api/admin/orphan-status-rows/route.ts). Remove this variable together
# with that route once the cleanup is done. Empty = the route refuses every request.
LEAD_STATUS_ADMIN_SECRET=

# Meta Conversions API (CAPI) - Lead event (see src/lib/meta-capi/)
#
# NOT sent anywhere yet even once these are filled in - see
# META_CAPI_SEND_ENABLED below. Find these in Meta Events Manager: your
# Pixel/Dataset -> Settings -> Conversions API -> Generate access token.
# Website pixel only. The CRM feedback below uses META_CRM_ACCESS_TOKEN and META_CRM_DATASET_ID.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Explicit go-live switch, separate from the two credentials above on
# purpose: set to exactly "true" only once you've confirmed the Pixel/Dataset
# ID and access token above are correct and you want this app to start
# sending real Lead events to Meta. Leaving this empty (or anything other
# than "true") means sendLeadEvent() always refuses to call Meta, no matter
# what the two credentials above are set to.
META_CAPI_SEND_ENABLED=

# Meta CRM feedback - lead-quality events from CRM status changes (see src/lib/crm-capi/).
# Sending stays OFF until META_CAPI_CRM_SEND_ENABLED is true AND both
# META_CRM_DATASET_ID and META_CRM_ACCESS_TOKEN are set. The CRM dataset is a
# separate Meta dataset of type CRM. The CRM path never reads META_PIXEL_ID or
# META_CAPI_ACCESS_TOKEN (the website pixel's values) and has no fallback to them.
META_CRM_DATASET_ID=
META_CRM_ACCESS_TOKEN=
META_CAPI_CRM_SEND_ENABLED=
# Optional. Sends events to Meta's Test Events tab only, never to optimization. Use it before going live.
META_CAPI_CRM_TEST_EVENT_CODE=
# Bearer secret for POST /api/admin/crm-capi/flush, which retries due events. Empty = the route refuses every request.
CRM_CAPI_FLUSH_SECRET=

# Optional. "1" writes counts-only diagnostic lines for Meta reads to the server log (never personal data).
# Leave empty in production.
META_DEBUG_ACTIONS=

# The dashboard has no sign-in and reads no team password. DASHBOARD_PASSWORD and SESSION_SECRET are no longer read by the
# app and can be removed from the hosting settings later.
