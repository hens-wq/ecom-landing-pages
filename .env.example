# Meta Marketing API - Phase 2A (read-only)
#
# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it's already gitignored). All of these are read server-side only (see
# src/lib/advertising/meta/config.ts) - none of them are exposed to the browser,
# and none use the NEXT_PUBLIC_ prefix on purpose.
#
# If META_ACCESS_TOKEN and META_AD_ACCOUNT_ID are both left empty, the dashboard
# automatically falls back to the existing mock advertising data (Phase 1
# behavior) - this is the expected state until you provide real credentials.

# A valid Meta access token with ads_read permission on the ad account below.
# For a long-lived, non-expiring integration, use a System User access token
# generated in Meta Business Settings (Business Settings -> Users -> System
# Users -> Generate New Token), not a short-lived personal user token.
META_ACCESS_TOKEN=

# The Meta Ads account to read from. Either form works - with or without the
# "act_" prefix (e.g. "act_1234567890" or just "1234567890"); it's normalized
# automatically. Find it in Meta Ads Manager: Account overview, or in the URL
# when viewing the account (act_<numbers>).
META_AD_ACCOUNT_ID=

# The Meta App this token belongs to. Not required for the read-only calls this
# phase makes, but kept for reference/traceability and for a future
# appsecret_proof / token-refresh flow.
META_APP_ID=

# Graph API version to call, e.g. "v26.0". Meta retires versions roughly every
# 2 years, so this WILL need bumping over time - keeping it here instead of
# hardcoded in source means updating it never requires a code change.
META_GRAPH_API_VERSION=v26.0

# IANA timezone "Today" / date-range presets are resolved in, so they match
# Ads Manager's own "Today" instead of drifting with the server's UTC clock.
# Defaults to "Asia/Jerusalem" if left empty - only set this if the ad
# account's actual configured reporting timezone is different.
REPORTING_TIMEZONE=

# Neon Postgres connection string for the internal lead status/payment data
# (see src/lib/lead-status/db.ts + repository.ts) - Main/Secondary status and
# payment amounts on the Leads page. Read server-side only, never exposed to
# the browser. When linked to a Vercel project through the Neon integration,
# Vercel sets this automatically for Production and Preview - you don't need
# to set it here unless you're also running this app outside Vercel (e.g.
# local development against your own Neon branch/database).
DATABASE_URL=
