# Lead delivery — server-side only, never exposed to the client.
# When unset, submitted leads are validated and logged, never sent anywhere.
# Point this at the Make/Zapier webhook (or intermediate Sheets step) that
# ultimately lands in Fireberry CRM.
# Only applies to the Node.js build (npm run build / Vercel). The static
# export (npm run build:static, for hosts with no Node.js) has no server
# to read this — it uses public/lead-config.js instead. See README.md
# "Deploying as a static export".
LEAD_WEBHOOK_URL=

# Analytics — each integration activates only once its ID is set.
# NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time, not
# read at runtime — on Vercel that means setting/changing one requires a
# redeploy (Deployments -> ... -> Redeploy), not just saving the env var.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
